
# ============================================
# Advanced Guess The Number Game in Python
# ============================================

import random
import time

# ============================================
# Game Introduction
# ============================================

print("=" * 50)
print("🎮 WELCOME TO GUESS THE NUMBER GAME 🎮")
print("=" * 50)

player_name = input("Enter Your Name: ")

print(f"\nHello {player_name}!")
print("I am thinking of a number.")
print("You have to guess it correctly.")
print("\nGame Modes:")
print("1. Easy   (1 - 50)")
print("2. Medium (1 - 100)")
print("3. Hard   (1 - 500)")

# ============================================
# Select Difficulty
# ============================================

while True:
    try:
        choice = int(input("\nSelect Difficulty Level (1/2/3): "))

        if choice == 1:
            max_number = 50
            total_attempts = 10
            break

        elif choice == 2:
            max_number = 100
            total_attempts = 7
            break

        elif choice == 3:
            max_number = 500
            total_attempts = 5
            break

        else:
            print("❌ Please choose valid option.")

    except:
        print("❌ Invalid Input.")

# ============================================
# Generate Random Number
# ============================================

secret_number = random.randint(1, max_number)

print(f"\n🎯 Guess a number between 1 and {max_number}")
print(f"You have {total_attempts} attempts.")

# ============================================
# Game Variables
# ============================================

attempt = 0
score = 100
start_time = time.time()

# ============================================
# Main Game Loop
# ============================================

while attempt < total_attempts:

    try:
        guess = int(input(f"\nAttempt {attempt + 1}: Enter Your Guess: "))
        attempt += 1

        # ====================================
        # Check Guess
        # ====================================

        if guess == secret_number:

            end_time = time.time()
            total_time = round(end_time - start_time, 2)

            print("\n🎉 CONGRATULATIONS 🎉")
            print(f"Correct Guess! The number was {secret_number}")

            # Bonus Score
            bonus = (total_attempts - attempt) * 10
            final_score = score + bonus

            print(f"🏆 Final Score: {final_score}")
            print(f"⏱️ Time Taken: {total_time} seconds")

            # Rank System
            if final_score >= 140:
                print("🌟 Rank: MASTER GUESSER")

            elif final_score >= 100:
                print("🔥 Rank: EXPERT PLAYER")

            elif final_score >= 70:
                print("👍 Rank: GOOD PLAYER")

            else:
                print("🙂 Rank: BEGINNER")

            break

        elif guess < secret_number:
            print("📉 Too Low!")

        else:
            print("📈 Too High!")

        # ====================================
        # Hint System
        # ====================================

        difference = abs(secret_number - guess)

        if difference <= 5:
            print("🔥 Very Close!")

        elif difference <= 15:
            print("⚡ Close Guess!")

        elif difference <= 30:
            print("🙂 Far Away")

        else:
            print("❄️ Very Far")

        # Reduce Score
        score -= 10

        # Remaining Attempts
        remaining = total_attempts - attempt
        print(f"Remaining Attempts: {remaining}")

    except ValueError:
        print("❌ Please enter numbers only.")

# ============================================
# Game Over
# ============================================

if guess != secret_number:
    print("\n💀 GAME OVER 💀")
    print(f"The correct number was: {secret_number}")

# ============================================
# Replay Option
# ============================================

print("\n" + "=" * 50)

play_again = input("Do you want to play again? (yes/no): ")

if play_again.lower() == "yes":
    print("\nRestart the program to play again.")
else:
    print(f"\nThank you for playing, {player_name}!")
    print("👋 Goodbye!")

print("=" * 50)
